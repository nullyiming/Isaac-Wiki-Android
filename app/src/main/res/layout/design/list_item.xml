<?xml version="1.0" encoding="utf-8"?>
<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="56dp">

	<org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.ImageViewDesign
		android:src="@drawable/ic_launcher_round"
		android:padding="8dp"
		android:id="@+id/icon"
		android:layout_width="56dp"
		android:layout_height="56dp" />

	<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
		android:layout_width="match_parent"
		android:orientation="vertical"
		android:layout_height="56dp">

		<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
			android:layout_height="wrap_content"
			android:id="@+id/name"
			android:text="Name"
			android:textSize="14sp"
			android:layout_width="match_parent"
			android:layout_weight="1" />

		<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
			android:layout_height="wrap_content"
			android:text="TextView"
			android:layout_width="match_parent"
			android:id="@+id/type"
			android:textSize="8sp" />

	</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>